DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cashcompass
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cashcompass_test

# --- Layer 2: PII vault ---
# Generate keys with: python scripts/gen_vault_keys.py
DEFAULT_TENANT_ID=default
VAULT_KEY_SOURCE=env
VAULT_KEK_VERSION=1
VAULT_KEKS={"1":"<base64-32-bytes>"}
VAULT_HSK=<base64-32-bytes>
VAULT_ADMIN_KEY=<random-32-bytes-urlsafe>
VAULT_DETOKENIZE_ALLOWED_CALLERS=demo-user

# --- Layer 3a: evidence snapshot ---
# "fixture" = offline recorded responses (default). "live" needs the keys below.
EVIDENCE_MODE=fixture
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=

# --- Layer 3b: debate LLM ---
# none (default; debates refuse to run) | anthropic | ollama
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
