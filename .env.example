DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cashcompass
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cashcompass_test

# --- Layer 2: PII vault ---
# Generate keys with: python scripts/gen_vault_keys.py
DEFAULT_TENANT_ID=default
VAULT_KEY_SOURCE=env
VAULT_KEK_VERSION=1
VAULT_KEKS={"1":"<base64-32-bytes>"}
VAULT_HSK=<base64-32-bytes>
VAULT_ADMIN_KEY=<random-32-bytes-urlsafe>
VAULT_DETOKENIZE_ALLOWED_CALLERS=demo-user
